{
  "name": "Tara HR Coworker",
  "install": "./scripts/cloud-agent-install.sh",
  "start": "./scripts/cloud-agent-start.sh",
  "ports": [
    {
      "name": "web",
      "port": 5173
    },
    {
      "name": "api",
      "port": 8000
    }
  ],
  "terminals": [
    {
      "name": "api",
      "command": ".venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
      "description": "FastAPI backend for Tara HR coworker"
    },
    {
      "name": "web",
      "command": "cd frontend && npm run dev",
      "description": "Vite React frontend"
    }
  ]
}
